{
  "name": "billiards-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/web",
    "build:api": "cd apps/api && npx prisma generate && npx nest build",
    "build:web": "npm run build --workspace=apps/web",
    "start": "node apps/api/dist/main.js",
    "start:api": "node apps/api/dist/main.js",
    "start:web": "npm run start --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api"
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.9",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {}
}
